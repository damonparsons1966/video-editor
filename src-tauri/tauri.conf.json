{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Editor",
  "version": "0.1.0",
  "identifier": "com.videoeditor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Video Editor",
        "width": 1040,
        "height": 760,
        "minWidth": 840,
        "minHeight": 620,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=HardwareMediaKeyHandling"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost https://ipc.localhost; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; connect-src ipc: http://ipc.localhost https://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg"]
  }
}
